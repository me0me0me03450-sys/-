# --- Supabase (للإنتاج والربط السحابي مع PostgreSQL و Realtime) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# --- إعدادات الخادم المحلي (اختياري) ---
PORT=3000
# كلمة مرور اختيارية لحساب مديرة النظام (في حال تركها فارغة يتم إعداد الحساب الأول عبر الواجهة)
NIDAA_ADMIN_PASSWORD=
# مفتاح توقيع الجلسات (يتم توليد مفتاح عشوائي بالذاكرة تلقائياً إذا تُرك فارغاً)
NIDAA_SESSION_SECRET=
# عدد قفزات البروكسي الموثوقة فقط عند التشغيل خلف بروكسي معروف؛ اتركيه فارغاً مباشرة أو عند عدم التأكد
NIDAA_TRUST_PROXY_HOPS=
